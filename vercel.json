{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {"source":"/methodology","destination":"/methodology"},
    {"source":"/canada","destination":"/country"},
    {"source":"/united-states","destination":"/country"},
    {"source":"/united-kingdom","destination":"/country"},
    {"source":"/germany","destination":"/country"},
    {"source":"/estonia","destination":"/country"},
    {"source":"/taiwan","destination":"/country"},
    {"source":"/canada/toronto","destination":"/city"},
    {"source":"/united-states/new-york","destination":"/city"},
    {"source":"/united-states/san-francisco","destination":"/city"},
    {"source":"/united-kingdom/london","destination":"/city"},
    {"source":"/germany/berlin","destination":"/city"},
    {"source":"/estonia/tallinn","destination":"/city"},
    {"source":"/taiwan/taipei","destination":"/city"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}
